# ───────────── Network ─────────────
NEXT_PUBLIC_CHAIN_ID=43113
NEXT_PUBLIC_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc

# ───────────── WalletConnect ─────────────
# Get one free at cloud.walletconnect.com.
# Without it RainbowKit still renders, but the WalletConnect QR (mobile
# wallets) silently fails. Injected wallets (Core, MetaMask) keep working.
NEXT_PUBLIC_WC_PROJECT_ID=YOUR_WC_PROJECT_ID

# ───────────── Tessera contracts on Avalanche Fuji ─────────────
# Filled automatically by `pnpm sync-env` after `pnpm deploy:fuji`
# (and `pnpm deploy-public:fuji` for the public side). See the live
# addresses in ../contracts/deployments/fuji.json.
NEXT_PUBLIC_USDC_ADDRESS=
NEXT_PUBLIC_IDENTITY_REGISTRY=
NEXT_PUBLIC_ORDERBOOK_ADDRESS=

# Private universe — LatAm private equity SecurityTokens
NEXT_PUBLIC_TOKEN_KVK=
NEXT_PUBLIC_TOKEN_BTS=
NEXT_PUBLIC_TOKEN_CLP=
NEXT_PUBLIC_TOKEN_ARK1=

# Public universe — US stocks mirror (Dinari-shaped)
NEXT_PUBLIC_TOKEN_AAPL=
NEXT_PUBLIC_TOKEN_MSFT=
NEXT_PUBLIC_TOKEN_NVDA=
NEXT_PUBLIC_TOKEN_GOOGL=
NEXT_PUBLIC_TOKEN_AMZN=
NEXT_PUBLIC_TOKEN_META=

# ───────────── Server-only secrets (NEVER NEXT_PUBLIC_) ─────────────
# Wallet that signs `IdentityRegistry.addIdentity` on /api/kyc/verify.
# For the demo this is the same key as `contracts/.env::PRIVATE_KEY`
# (the deployer owns the registry). In production this would be a KMS
# or multisig.
KYC_ISSUER_PRIVATE_KEY=

# Dinari sandbox API — server-side proxy in /api/dinari/* uses these.
# Get keys at partners.dinari.com (self-serve, instant).
DINARI_API_BASE=https://api-enterprise.sandbox.dinari.com
DINARI_API_KEY_ID=
DINARI_API_SECRET=
DINARI_ENTITY_ID=
DINARI_ACCOUNT_ID=

# Wavy Node compliance — server-side proxy in /api/risk/* and
# /api/compliance/* uses these. Without them the integration stays in
# an honest "awaiting key" state (risk pill shows "pendiente", the
# /admin/reports page renders an "integration ready" banner). The raw
# key from the dashboard can be pasted as-is — the client tolerates
# both "wavy_..." and "ApiKey wavy_..." forms.
WAVY_API_BASE=https://api.wavynode.com/v1
WAVY_API_KEY=
WAVY_PROJECT_ID=

# Wavy Node demo mode — pitch-only fallback when the real API key
# hasn't landed yet. Set to "true" to make /admin/reports surface
# realistic mock data flagged with an unmissable "DEMO" banner.
# IGNORED when WAVY_API_KEY is set (real data always wins).
WAVY_DEMO_MODE=false
